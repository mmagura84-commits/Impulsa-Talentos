# ================================================================
# Impulsa Talentos — static SPA/SSR deployment on Apache
# Hostinger shared hosting: place this file at public_html/.htaccess
# ================================================================
Options -Indexes
RewriteEngine On

# Deploy staging/backup folder (scripts/remote-swap.sh) is never public.
RewriteRule ^\.deploy(/|$) - [F,L]

# --- 1. API endpoints are served only by the Node/Bun backend
#      (serve.ts). On static hosting they do not exist — return a real
#      404 instead of silently rewriting to the SPA shell.
RewriteRule ^api/ - [R=404,L]

# --- 2. SPA/SSR fallback -----------------------------------------
# Serve existing files and prerendered directories directly, e.g.
#   /jobs/<id>/index.html, /companies/<id>/index.html, /images/..., /assets/...
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
# Everything else -> the NEUTRAL SPA shell (empty body), never index.html:
# index.html is the prerendered HOME page, and hydrating it on /employer,
# /hq, /candidate, /dashboard, /m/*, /apply/* or a job posted after the last
# build throws React error #418. spa-fallback.html is generated by
# scripts/finalize-static-build.mjs for exactly this.
RewriteCond %{DOCUMENT_ROOT}/spa-fallback.html -f
RewriteRule ^ /spa-fallback.html [L]
RewriteRule ^ /index.html [L]

# --- 3. Compression (recommended) ---------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# --- 4. Cache policy ------------------------------------------------
# Prerendered HTML changes on every redeploy -> never cache it.
# Versioned /assets/* (content-hashed filenames) are immutable -> cache 1 year.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  # Explicit immutable Cache-Control for content-hashed assets under /assets/.
  # (All JS/CSS in this build live under /assets/ and embed their content hash
  # in the filename, so this can never serve stale code after a redeploy.)
  <LocationMatch "^/assets/">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </LocationMatch>
  # HTML: always revalidate so new publishes are picked up immediately.
  <LocationMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </LocationMatch>
</IfModule>
