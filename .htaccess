# ================================================================
# Impulsa Talentos — static SPA/SSR deployment on Apache
# Hostinger shared hosting: place this file at public_html/.htaccess
# ================================================================
Options -Indexes
# Hostinger answers unknown paths with the prerendered home page unless told
# otherwise; if the rewrite below is not applied, the 404 handler still hands
# out the neutral SPA shell (status 404, page renders normally).
ErrorDocument 404 /spa-fallback.html
RewriteEngine On

# Deploy staging/backup folder (scripts/remote-swap.sh) is never public.
RewriteRule ^\.deploy(/|$) - [F,L]

# --- 1. API endpoints are served only by the Node/Bun backend
#      (serve.ts). On static hosting they do not exist — return a real
#      404 instead of silently rewriting to the SPA shell.
# ([F] = 403: Hostinger's LiteSpeed ignores R=404 on a "-" rule and served the
# home page for /api/* instead.)
RewriteRule ^api/ - [F,L]

# --- 2. SPA/SSR fallback -----------------------------------------
# Serve existing files and prerendered directories directly, e.g.
#   /jobs/<id>/index.html, /companies/<id>/index.html, /images/..., /assets/...
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
# Everything else -> the NEUTRAL SPA shell (empty body), never index.html:
# index.html is the prerendered HOME page, and hydrating it on /employer,
# /hq, /candidate, /dashboard, /m/*, /apply/* or a job posted after the last
# build throws React error #418. spa-fallback.html is generated by
# scripts/finalize-static-build.mjs for exactly this.
# (no DOCUMENT_ROOT check: on Hostinger it is not public_html, so the check
# always failed; the deploy refuses a build without spa-fallback.html)
RewriteRule ^ /spa-fallback.html [L]

# --- 3. Compression (recommended) ---------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# --- 4. Cache policy ------------------------------------------------
# Prerendered HTML changes on every redeploy -> never cache it.
# Versioned /assets/* (content-hashed filenames) are immutable -> cache 1 year.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  # FilesMatch (not LocationMatch, which .htaccess does not allow and was
  # silently ignored, so Hostinger's CDN cached pages for a year and served
  # old HTML pointing at deleted scripts after a deploy).
  # Pages (index.html inside each prerendered folder, spa-fallback.html):
  # the CDN and browsers must check for a new version every time.
  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header always set Cache-Control "no-cache, must-revalidate"
    Header unset Expires
    Header set X-Impulsa-Cache "page"
  </FilesMatch>
  # All JS/CSS live in /assets/ with a content hash in the name: immutable.
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header set X-Impulsa-Cache "asset"
  </FilesMatch>
</IfModule>
