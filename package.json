{
  "name": "vite-react-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-sitemap.mjs && vite build && node scripts/finalize-static-build.mjs",
    "start": "bun run serve.ts",
    "publish": "bun run build && bun run start",
    "preview": "vite preview",
    "lint:css": "stylelint \"src/**/*.css\" --quiet",
    "lint:js": "eslint . --report-unused-disable-directives",
    "lint:types": "tsc --noEmit",
    "lint": "bun run lint:types && bun run lint:js && bun run lint:css",
    "test:e2e": "playwright test"
  },
